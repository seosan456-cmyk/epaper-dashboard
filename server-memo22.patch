s.command(3,new Uint8Array([offset&255,offset>>8,...bytes.slice(offset,offset+16)]));onProgress(Math.min(100,Math.round((offset+16)/bytes.length*100)));}\n    onProgress(100);await this.command(4,new Uint8Array(),30000);\n  }\n}\n\nconst $=id=>document.getElementById(id);\nlet device,link,profiles=[],working=false,expectedDisconnect=false;\nlet firmwareVersion=1,dirty=false,loaded=false,dashboardConfigured=false;\nlet completionMessage='설정이 저장되었고 연결이 종료됐어요. 기기가 Wi-Fi로 화면을 갱신합니다.';\nconst message=(value,error=false)=>{$('message').textContent=value;$('message').classList.toggle('error',error);};\nfunction setBusy(value){working=value;$('connect').disabled=value||!!link;$('fields').disabled=value||!link;$('save').disabled=value||!link;}\nfunction drawNetworks(){\n  const root=$('profiles');root.replaceChildren();\n  profiles.forEach((p,index)=>{\n    const card=document.createElement('div');card.className='network';\n    const header=document.createElement('div');header.className='network-head';\n    const label=document.createElement('b');label.textContent=index===0?'01 · 우선 연결':String(index+1).padStart(2,'0');header.append(label);\n    const actions=document.createElement('div');\n    if(index){const up=document.createElement('button');up.type='button';up.textContent='위로';up.onclick=()=>{[profiles[index-1],profiles[index]]=[profiles[index],profiles[index-1]];drawNetworks();};actions.append(up);}\n    const remove=document.createElement('button');remove.type='button';remove.textContent='삭제';remove.onclick=()=>{profiles.splice(index,1);drawNetworks();};actions.append(remove);header.append(actions);card.append(header);\n    const ssidLabel=document.createElement('label');ssidLabel.textContent='Wi-Fi 이름';const ssid=document.createElement('input');ssid.type='text';ssid.value=p.ssid;ssid.autocomplete='off';ssid.spellcheck=false;ssid.placeholder='예: Home Wi-Fi';ssid.oninput=()=>{p.ssid=ssid.value;p.keep=p.ssid===p.savedSsid&&p.hasPassword;};ssidLabel.append(ssid);card.append(ssidLabel);\n    const passLabel=document.createElement('label');passLabel.textContent='비밀번호';const password=document.createElement('input');password.type='password';password.autocomplete='new-password';password.value=p.password;password.placeholder=p.hasPassword?'입력하지 않으면 기존 비밀번호 유지':'Wi-Fi 비밀번호';password.disabled=p.open;password.oninput=()=>p.password=password.value;passLabel.append(password);card.append(passLabel);\n    const openLabel=document.createElement('label');openLabel.className='open';const open=document.createElement('input');open.type='checkbox';open.checked=p.open;open.onchange=()=>{p.open=open.checked;password.disabled=p.open;};openLabel.append(open,document.createTextNode('비밀번호 없는 Wi-Fi'));card.append(openLabel);root.append(card);\n  });$('addWifi').disabled=profiles.length>=4;\n}\nfunction memoCount(){const n=[...$('memo').value].length,bytes=new TextEncoder().encode($('memo').value).length;$('counter').textContent=`${n} / 200자 · ${bytes} / 600바이트`;$('counter').classList.toggle('error',n>200||bytes>600);}\nfunction showSettings(s){\n  if(s.version!==1&&s.version!==2)throw Error('이 설정 페이지와 펌웨어 버전이 맞지 않아요.');\n  firmwareVersion=s.version;dashboardConfigured=!!s.dashboardConfigured;\n  $('dashboardFields').disabled=s.version<2;\n  $('dashboardHint').textContent=s.version<2?'이 기능은 v2.0 펌웨어 업로드 후 사용할 수 있어요.':s.dashboardConfigured?'기기에 저장된 내용을 불러왔어요. 빈 항목은 표시하지 않습니다.':'최초 설정입니다. 기존 시트 내용은 자동으로 복사되지 않아요. 아래에 입력하고 저장하면 기기 설정으로 전환됩니다.';\n  const d=s.dashboard||emptyDashboard();fillDashboard(d);\n  dirty=false;loaded=true;\n  document.querySelector(`input[name=mode][value=\"${s.mode}\"]`).checked=true;\n  for(const id of ['interval','fullInterval','quietStart','quietEnd'])$(id).value=s[id];\n  $('partial').checked=!!(s.flags&1);$('quiet').checked=!!(s.flags&2);$('quietHours').hidden=!$('quiet').checked;\n  $('memo').value=s.memo;memoCount();profiles=s.profiles.map(p=>({...p,savedSsid:p.ssid,keep:p.hasPassword,password:'',open:!p.hasPassword}));\n  if(!pro